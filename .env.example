DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=privacyhub
POSTGRES_OWNER_USER=privacyhub_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-local-owner-password
POSTGRES_APP_USER=privacyhub_app
POSTGRES_APP_PASSWORD=replace-with-a-local-app-password
# Local development outside Docker uses these app-role settings.
POSTGRES_USER=privacyhub_app
POSTGRES_PASSWORD=replace-with-a-local-app-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DJANGO_SECURE_COOKIES=false
# Set all five values below for an HTTPS deployment before running --deploy.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_BEHIND_SSL_PROXY=false
